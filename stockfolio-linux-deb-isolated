#!/usr/bin/env bash
set -euo pipefail

# Run on the host when launched from a Flatpak editor.
script_dir="$(cd -- "$(dirname -- "$0")" && pwd)"
if [[ -f /.flatpak-info ]]; then
  exec flatpak-spawn --host bash "$script_dir/stockfolio-linux-deb-isolated" "$@"
fi
if [[ "${1:-}" != --worker ]]; then
  exec setsid --wait bash "$script_dir/stockfolio-linux-deb-isolated" --worker
fi

build_id="$(date -u +%Y%m%d%H%M%S)-$$"
build_root="$script_dir/.deb-builds.local/$build_id"
snapshot="$build_root/source"
mkdir -p "$snapshot/src-tauri" "$build_root/cargo-home"
exec > >(tee "$build_root/build.log") 2>&1
echo "Isolated build: $build_root"
echo "Process: $$; package/executable: stockfolio-build-$build_id"

# Copy the current working tree, including uncommitted source edits, without
# sharing writable frontend output, Cargo locks, dependencies, or target files.
cp --reflink=auto -a "$script_dir/src" "$script_dir/node_modules" "$snapshot/"
cp --reflink=auto -a "$script_dir/"{package.json,package-lock.json,index.html,tsconfig.json,tsconfig.node.json,vite.config.ts} "$snapshot/"
cp --reflink=auto -a "$script_dir/src-tauri/"{src,icons,capabilities,Cargo.toml,Cargo.lock,build.rs,tauri.conf.json} "$snapshot/src-tauri/"
original_cargo_home="${CARGO_HOME:-$HOME/.cargo}"
if [[ -d "$original_cargo_home/registry" ]]; then
  cp --reflink=auto -a "$original_cargo_home/registry" "$build_root/cargo-home/"
fi
if [[ -d "$original_cargo_home/git" ]]; then
  cp --reflink=auto -a "$original_cargo_home/git" "$build_root/cargo-home/"
fi

# Apply isolation only to the snapshot; the normal application's configuration
# and sources remain unchanged. Port 0 asks the OS for an unused loopback port.
node - "$snapshot" "$build_id" <<'NODE'
const fs = require('node:fs');
const path = require('node:path');
const [root, id] = process.argv.slice(2);
const identifier = `com.stockfolio.build${id.replaceAll('-', '')}`;
const configPath = path.join(root, 'src-tauri/tauri.conf.json');
const config = JSON.parse(fs.readFileSync(configPath, 'utf8'));
config.productName = `Stockfolio Build ${id}`;
config.mainBinaryName = `stockfolio-build-${id}`;
config.identifier = identifier;
config.app.windows.forEach(window => { window.title = config.productName; });
config.bundle.targets = ['deb'];
fs.writeFileSync(configPath, JSON.stringify(config, null, 2) + '\n');
function replace(file, before, after) {
  const target = path.join(root, 'src-tauri/src', file);
  const source = fs.readFileSync(target, 'utf8');
  if (!source.includes(before)) throw new Error(`Isolation patch no longer matches ${file}`);
  fs.writeFileSync(target, source.replace(before, after));
}
replace('secrets.rs', 'const SERVICE: &str = "com.stockfolio.app";', `const SERVICE: &str = "${identifier}";`);
replace('browser_server.rs', 'pub fn start(app: AppHandle) -> Result<(), String>', 'pub fn start(app: AppHandle) -> Result<u16, String>');
replace('browser_server.rs', 'unwrap_or_else(|_| "1422".into())', 'unwrap_or_else(|_| "0".into())');
replace('browser_server.rs', '    listener.set_nonblocking(true)', '    let port = listener.local_addr().map_err(|e| e.to_string())?.port();\n    listener.set_nonblocking(true)');
replace('browser_server.rs', '    Ok(())\n}', '    Ok(port)\n}');
replace('lib.rs', 'browser_server::start(app.handle().clone())?;', 'let browser_port = browser_server::start(app.handle().clone())?;');
replace('lib.rs', 'std::env::var("STOCKFOLIO_BROWSER_PORT").unwrap_or_else(|_| "1422".into())', 'browser_port');
fs.writeFileSync(path.join(root, '../build-info.json'), JSON.stringify({
  buildId: id, identifier, executable: config.mainBinaryName,
  productName: config.productName, version: config.version,
}, null, 2) + '\n');
NODE

export CARGO_HOME="$build_root/cargo-home"
export CARGO_TARGET_DIR="$build_root/target"
export CARGO_BUILD_JOBS="${STOCKFOLIO_BUILD_JOBS:-4}"
export PATH="$HOME/.cargo/bin:$PATH"
cd "$snapshot"
nice -n 10 node node_modules/@tauri-apps/cli/tauri.js build --ci --bundles deb -- --locked
find "$CARGO_TARGET_DIR/release/bundle/deb" -maxdepth 1 -name '*.deb' -exec cp -- '{}' "$build_root/" \;
cd "$build_root"
sha256sum ./*.deb > SHA256SUMS
echo "Build complete: $build_root"
