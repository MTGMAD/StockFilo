#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd -- "$(dirname -- "$0")" && pwd)"

export PATH="$HOME/.cargo/bin:$PATH"

# Ensure npm/node are available when launched outside an initialized shell.
if [[ -s "$HOME/.nvm/nvm.sh" ]]; then
	# shellcheck disable=SC1090
	. "$HOME/.nvm/nvm.sh"
fi

# VS Code installed via Snap can inject GTK/GIO paths that pull incompatible
# snap GLIBC libs at runtime. Clear them so Tauri uses system libraries.
unset GTK_PATH
unset GIO_MODULE_DIR
unset GDK_PIXBUF_MODULEDIR
unset GTK_EXE_PREFIX
unset GTK_DATA_PREFIX

if [[ "${LD_LIBRARY_PATH:-}" == *"/snap/"* ]]; then
	unset LD_LIBRARY_PATH
fi

export GDK_BACKEND=x11
export WEBKIT_DISABLE_COMPOSITING_MODE=1
export WEBKIT_DISABLE_GPU_PROCTYPES=1
export LIBGL_ALWAYS_INDIRECT=1
cd "$script_dir"
rm -rf node_modules/.vite
npm run tauri dev