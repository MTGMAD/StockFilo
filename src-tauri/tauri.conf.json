{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stockfolio",
  "version": "0.1.9",
  "identifier": "com.stockfolio.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Stockfolio",
        "width": 1200,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Finance",
    "shortDescription": "Track stock portfolios and investment research",
    "longDescription": "Stockfolio helps you track stock portfolios, record investment research, and review your holdings in a desktop application.",
    "homepage": "https://github.com/MTGMAD/StockFilo",
    "license": "Apache-2.0",
    "linux": {
      "deb": {
        "section": "utils",
        "files": {
          "/usr/share/metainfo/com.stockfolio.app.metainfo.xml": "linux/com.stockfolio.app.metainfo.xml"
        }
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
